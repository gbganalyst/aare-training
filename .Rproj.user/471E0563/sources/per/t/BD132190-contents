```{r}
heart <-  readxl::read_xlsx("data/heart.xlsx") |> 
  janitor::clean_names()

heart |>
  drop_na(systolic, smoking_status) |>
    summarise(
    n = n(),
    mean_systolic = mean(systolic),
    sd_systolic = sd(systolic),
    se_systolic = sd_systolic / sqrt(n),
    ci_systolic = qt(0.975, df = n - 1) * se_systolic,
    ci_lower = mean_systolic - ci_systolic,
    ci_upper = mean_systolic + ci_systolic,
    .by = smoking_status,
    ) |> 
  ungroup()
```

```{r}
# alternative
heart |>
  drop_na(systolic, smoking_status) |>
  group_by(smoking_status) |>
  summarise(
    n = n(),
    mean_systolic = mean(systolic),
    sd_systolic = sd(systolic),
    se_systolic = sd_systolic / sqrt(n),
    ci_systolic = qt(0.975, df = n - 1) * se_systolic,
    ci_lower = mean_systolic - ci_systolic,
    ci_upper = mean_systolic + ci_systolic,
    .groups = "drop"
  )
```

