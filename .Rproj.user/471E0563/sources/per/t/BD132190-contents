```{r}
multi60 <- function(x){
  x*60
}


msleep |>
  select(name, contains("sleep")) |> # Focus on sleep-related columns
  mutate_at(c("sleep_total", "sleep_rem", "sleep_cycle"), multi60) # Multiply each value by 60
```

